# Copy to .env and fill in. NEVER commit a real .env to git.
# The app is safe by default: DRY_RUN=true means NO real email is sent.

# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:5000

# --- Safety (keep DRY_RUN=true until you have written authorization) ---
DRY_RUN=true
# Demo mode: read-only public tour without the admin password.
# Sending is disabled entirely when DEMO_MODE=true. Used on Vercel.
DEMO_MODE=false
# Only these domains may ever receive a real simulation email.
ALLOWED_DOMAINS=example.com

# --- SMTP (only used when DRY_RUN=false) ---
# Local testing with MailHog: docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=false
SMTP_FROM=security-training@example.com

# --- Admin login ---
ADMIN_USER=admin
ADMIN_PASS=changeme

# --- Branding ---
COMPANY_NAME=Acme Corp
